#include<iostream>
#include<vector>
#include<algorithm>
using namespace std;
int main()
{
    vector <int> v;
    v.push_back(1);
    v.push_back(3);
    v.push_back(5);
    v.push_back(7);
    v.push_back(9);

    cout<<" finding 7 "<<binary_search(v.begin(), v.end(), 7);
    cout<<"lower bound"<<lower_bound(v.begin(), v.end(), 6)-v.begin()<<endl;
    cout<<"lower bound"<<lower_bound(v.begin(), v.end(), 4)-v.begin()<<endl;

    int a=2; 
    int b=5;

    cout<<"max"<<max(a,b);
    cout<<"min"<<min(a,b);

    swap(a,b);

    string s = "abcd";
    reverse(s.begin(), s.end());
    cout<<s;

    // Rotating the vector
    rotate(v.begin(), v.begin() + 1, v.end());

    cout << "after rotate" << endl;
    for(int i : v) {
        cout << i << " ";
    }
    cout << endl;

    // Sorting the vector
    sort(v.begin(), v.end());

    cout << "after sort" << endl;
    for(int i : v) {
        cout << i << " ";
    }
    cout << endl;


}